#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#include <dt-bindings/zmk/pointing.h>

// Keyball44 のレイヤ構成を移植
// 0: BASE / 1: Space ホールド (F・矢印・マウス) / 2: 英数・かなホールド (数字・記号)
// 3: 右端の左親指(英数)ホールド (数字・BT・システム、ボールはスクロール = moNa2_R.overlay の scroll-layers)

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W     &kp E      &kp R        &kp T                                           &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S     &kp D      &kp F        &kp G                            &kp SQT        &kp H        &kp J  &kp K      &kp L    &kp SEMI
&mt LSHIFT Z      &kp X     &kp C      &kp V        &kp B        &kp TAB             &kp BSPC       &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL         &kp LALT  &kp LGUI   &lt 2 LANG2  &lt 1 SPACE  &lt 3 LANG2         &lt 2 LANG1    &mt RGUI ENTER                          &kp ESC
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp F1  &kp F2    &kp F3    &kp F4     &kp F5                             &kp F6     &mkp MB4   &kp F8     &mkp MB5    &kp F12
&trans  &trans    &kp UP    &kp ENTER  &kp DEL               &mkp MB3     &kp PG_UP  &mkp MB1   &kp UP     &mkp MB2    &kp F10
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp BSPC  &kp F9      &kp F7       &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT   &kp F11
&trans  &trans    &trans    &trans     &trans    &trans      &trans       &trans                                         &kp LS(LG(N4))
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&kp DQT    &kp N7  &kp N8  &kp N9  &kp STAR                            &kp EXCL  &kp LPAR  &kp RPAR  &kp AT    &kp GRAVE
&kp COLON  &kp N4  &kp N5  &kp N6  &kp PIPE             &trans         &kp BSLH  &kp MINUS &kp EQUAL &kp BSLH  &kp SQT
&kp UNDER  &kp N1  &kp N2  &kp N3  &kp PRCNT  &trans    &trans         &kp AMPS  &kp LBKT  &kp RBKT  &kp STAR  &kp QMARK
&trans     &kp N0  &kp DOT &trans  &trans     &trans    &trans         &trans                                  &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                       &trans  &kp N7  &kp N8  &kp N9  &trans
&trans            &trans        &trans        &trans        &trans                  &trans     &trans  &kp N4  &kp N5  &kp N6  &trans
&trans            &trans        &trans        &trans        &trans        &trans    &trans     &kp N0  &kp N1  &kp N2  &kp N3  &trans
&bt BT_CLR_ALL    &bootloader   &bt BT_CLR    &trans        &trans        &trans    &trans     &trans                          &kp LS(LG(N5))
            >;
            sensor-bindings = <&scroll_up_down>;
        };
    };
};
